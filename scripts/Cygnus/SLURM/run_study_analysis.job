#!/usr/bin/env bash
# Generic preparation / information-group / finalization launcher for the Cygnus
# Slurm cluster. Mirrors scripts/Potsdam/SLURM/run_study_analysis.job (same
# ROLE EXECUTION_MANIFEST contract, consumed by analysis_slurm.py) with the
# Cygnus runtime: MA-CC checkout + mamba env, no conda, no /work paths.
#SBATCH --job-name=mas-cc-analysis
#SBATCH --output=/shared/home/cesar/LanguageGames/MA-CC/results/slurm-logs/analysis-%A_%a.out
#SBATCH --error=/shared/home/cesar/LanguageGames/MA-CC/results/slurm-logs/analysis-%A_%a.err
set -euo pipefail
if [[ $# -ne 2 ]]; then
  echo "usage: run_study_analysis.job ROLE EXECUTION_MANIFEST" >&2
  exit 2
fi
readonly REPOSITORY_ROOT="${MA_CC_REPOSITORY_ROOT:-/shared/home/cesar/LanguageGames/MA-CC}"
readonly MA_CC_PYTHON="${MA_CC_PYTHON:-/shared/home/cesar/.local/share/mamba/envs/MA-CC/bin/python}"
cd "$REPOSITORY_ROOT"
export PYTHONPATH="${PYTHONPATH:-$REPOSITORY_ROOT/src}"
export MA_CC_REPOSITORY_ROOT="$REPOSITORY_ROOT"
export MPLBACKEND=Agg
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
echo "[analysis] role=$1 manifest=$2 job=${SLURM_JOB_ID:-manual} cpus=${SLURM_CPUS_PER_TASK:-?} mem=${SLURM_MEM_PER_NODE:-?} node=${SLURMD_NODENAME:-?}"
exec "$MA_CC_PYTHON" -m mas_cc.studies.analysis_worker "$1" "$2"
