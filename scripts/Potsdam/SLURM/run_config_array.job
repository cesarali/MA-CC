#!/usr/bin/env bash
#SBATCH --job-name=mas-cc-study
# Site-safe fallback for direct sbatch use. `mas-cc study submit` overrides
# these with the selected study root's absolute logs directory.
#SBATCH --output=/work/ojedamarin/Projects/LanguageGames/MA-CC/logs/slurm-%A_%a.out
#SBATCH --error=/work/ojedamarin/Projects/LanguageGames/MA-CC/logs/slurm-%A_%a.err

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: run_config_array.job SUBMISSION_MANIFEST" >&2
  exit 2
fi

export MAS_CC_EXECUTION_SITE=potsdam
readonly CONDA_EXE=/home/ojedamarin/.local/share/miniforge3/bin/conda

exec "$CONDA_EXE" run -n MA-CC --live-stream \
  python -m mas_cc.studies.array_worker "$1"
