#!/usr/bin/env bash
# Generic Potsdam launcher for provider-backed MA-CC probes.
# Resource requests and absolute log paths are supplied by sbatch.

set -euo pipefail

if [[ $# -lt 2 || $# -gt 5 ]]; then
  echo "usage: run_probe.job PROBE_CONFIG OUTPUT_DIR [PREFLIGHT_APPROVAL] [REQUEST_SET] [EXECUTION_PROFILE]" >&2
  exit 2
fi

readonly CONDA_EXE=/home/ojedamarin/.local/share/miniforge3/bin/conda
readonly PROBE_CONFIG=$1
readonly OUTPUT_DIR=$2
readonly PREFLIGHT_APPROVAL=${3:-}
readonly REQUEST_SET=${4:-full}
readonly EXECUTION_PROFILE=${5:-cluster}

command=(
  "$CONDA_EXE" run -n MA-CC --live-stream
  mas-cc probe run --config "$PROBE_CONFIG" --output-dir "$OUTPUT_DIR"
)
if [[ -n "$PREFLIGHT_APPROVAL" ]]; then
  command+=(--approve-preflight "$PREFLIGHT_APPROVAL")
fi
command+=(--request-set "$REQUEST_SET" --execution-profile "$EXECUTION_PROFILE")
exec "${command[@]}"
