#!/bin/bash
# Run the six-model atomic-control focal-kernel calibration as one Slurm array.
#
# Submit from the repository root:
#   sbatch scripts/Potsdam/SLURM/focal_kernel_atomic_control_calibration.job

#SBATCH --job-name=mascc-focal-kernel
#SBATCH --array=0-5%6
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=6G
#SBATCH --time=12:00:00
#SBATCH --chdir=/home/ojedamarin/Projects/LanguageGames/MA-CC
#SBATCH --mail-type=END,FAIL
#SBATCH --output=/work/ojedamarin/Projects/LanguageGames/MA-CC/results/slurm-%x-%A_%a.out
#SBATCH --error=/work/ojedamarin/Projects/LanguageGames/MA-CC/results/slurm-%x-%A_%a.err

set -euo pipefail

readonly REPO_ROOT=/home/ojedamarin/Projects/LanguageGames/MA-CC
readonly CONDA_BIN=/home/ojedamarin/.local/share/miniforge3/bin/conda
readonly INPUT_DIR=${REPO_ROOT}/results/atomic_control_calibration/frozen_prompts
readonly RESPONSES_DIR=${REPO_ROOT}/results/atomic_control_calibration/responses
readonly RUNNER=scripts/experiment_design/focal_kernel_study/run_atomic_control_calibration.py
readonly CONCURRENCY=4

MODELS=(
  "gwdg/openai-gpt-oss-120b"
  "microsoft/Kimi-K2.6"
  "microsoft/gpt-5-mini"
  "microsoft/gpt-4o"
  "gwdg/qwen3-30b-a3b-instruct-2507"
  "up/gemma4-31b"
)

OUTPUT_NAMES=(
  "gwdg_openai_gpt_oss_120b"
  "microsoft_kimi_k2_6"
  "microsoft_gpt_5_mini"
  "microsoft_gpt_4o"
  "gwdg_qwen3_30b_a3b_instruct_2507"
  "up_gemma4_31b"
)

readonly ARRAY_INDEX=${SLURM_ARRAY_TASK_ID:?SLURM_ARRAY_TASK_ID is required}
readonly MODEL=${MODELS[$ARRAY_INDEX]}
readonly OUTPUT_NAME=${OUTPUT_NAMES[$ARRAY_INDEX]}

# The Potsdam GPT-5 route rejects temperature=0. The other routes use the
# deterministic calibration setting requested by the study.
if [[ "${MODEL}" == "microsoft/gpt-5-mini" ]]; then
  readonly TEMPERATURE=1
else
  readonly TEMPERATURE=0
fi

# GPT-OSS and Kimi expose reasoning tokens through the same completion budget;
# the 256-token default can end before their visible JSON vote is emitted.
if [[ "${MODEL}" == "gwdg/openai-gpt-oss-120b" || "${MODEL}" == "microsoft/Kimi-K2.6" ]]; then
  readonly MAX_OUTPUT_TOKENS=1024
else
  readonly MAX_OUTPUT_TOKENS=256
fi

export http_proxy=http://proxy2.uni-potsdam.de:3128
export https_proxy=http://proxy2.uni-potsdam.de:3128
export ftp_proxy=http://proxy2.uni-potsdam.de:3128
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

[[ -x "${CONDA_BIN}" ]] || { echo "[error] missing conda: ${CONDA_BIN}" >&2; exit 1; }
[[ -f "${REPO_ROOT}/.env" ]] || { echo "[error] missing ${REPO_ROOT}/.env" >&2; exit 1; }
[[ -f "${INPUT_DIR}/DATASET_MANIFEST.json" ]] || { echo "[error] frozen dataset missing" >&2; exit 1; }
[[ -f "${REPO_ROOT}/${RUNNER}" ]] || { echo "[error] runner missing" >&2; exit 1; }

set -a
# shellcheck disable=SC1091
source "${REPO_ROOT}/.env"
set +a

mkdir -p "${RESPONSES_DIR}/${OUTPUT_NAME}"
cd "${REPO_ROOT}"

echo "[run] job=${SLURM_ARRAY_JOB_ID:-manual}_${ARRAY_INDEX} model=${MODEL}"
echo "[run] concurrency=${CONCURRENCY} max_output_tokens=${MAX_OUTPUT_TOKENS} temperature=${TEMPERATURE}"
echo "[run] input=${INPUT_DIR}"
echo "[run] output=${RESPONSES_DIR}/${OUTPUT_NAME}"
echo "[run] start_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"

"${CONDA_BIN}" run --live-stream -n MA-CC python "${RUNNER}" \
  --input-dir "${INPUT_DIR}" \
  --output-dir "${RESPONSES_DIR}/${OUTPUT_NAME}" \
  --provider university \
  --model "${MODEL}" \
  --shard-index 0 \
  --num-shards 1 \
  --concurrency "${CONCURRENCY}" \
  --temperature "${TEMPERATURE}" \
  --max-output-tokens "${MAX_OUTPUT_TOKENS}" \
  --invalid-response-retries 2 \
  --progress never

echo "[done] model=${MODEL} end_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
