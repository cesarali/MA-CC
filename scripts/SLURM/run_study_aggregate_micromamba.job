#!/usr/bin/env bash
# Generic MA-CC local aggregation launcher for the shared micromamba cluster.
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: run_study_aggregate_micromamba.job STUDY_ROOT" >&2
  exit 2
fi

readonly REPOSITORY_ROOT="${MA_CC_REPOSITORY_ROOT:-/shared/home/cesar/LanguageGames/MA-CC}"
readonly MA_CC_PYTHON="${MA_CC_PYTHON:-/shared/home/cesar/.local/share/mamba/envs/MA-CC/bin/python}"

cd "$REPOSITORY_ROOT"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-1}"
export OPENBLAS_NUM_THREADS="${SLURM_CPUS_PER_TASK:-1}"
export MKL_NUM_THREADS="${SLURM_CPUS_PER_TASK:-1}"
export NUMEXPR_NUM_THREADS="${SLURM_CPUS_PER_TASK:-1}"

exec "$MA_CC_PYTHON" -m mas_cc.cli.main study aggregate \
  --study-dir "$1" \
  --backend local
