{
  "$id": "https://mas-cc.local/schemas/prompt-component-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "block_separator": {
      "type": "string"
    },
    "message_mode": {
      "enum": [
        "per_block",
        "merge_consecutive_roles"
      ]
    },
    "options": {
      "additionalProperties": true,
      "type": "object"
    },
    "prompt_family": {
      "minLength": 1,
      "type": "string"
    },
    "prompt_version": {
      "minimum": 1,
      "type": "integer"
    },
    "response_contract": {
      "properties": {
        "type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 2
    }
  },
  "required": [
    "schema_version",
    "prompt_family",
    "prompt_version"
  ],
  "title": "MAS-CC prompt component Version 2",
  "type": "object"
}
