{
  "$id": "https://mas-cc.local/schemas/run-config-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "estimators": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "options": {
          "additionalProperties": true,
          "type": "object"
        },
        "schema_version": {
          "const": 1
        }
      },
      "type": "object"
    },
    "execution": {
      "additionalProperties": false,
      "properties": {
        "fail_fast": {
          "type": "boolean"
        },
        "parallelism": {
          "minimum": 1,
          "type": "integer"
        },
        "repetitions": {
          "minimum": 1,
          "type": "integer"
        },
        "schema_version": {
          "const": 1
        },
        "seed": {
          "minimum": 0,
          "type": "integer"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "experiment": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": 1
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "game": {
      "additionalProperties": false,
      "properties": {
        "horizon": {
          "minimum": 1,
          "type": "integer"
        },
        "options": {
          "additionalProperties": true,
          "type": "object"
        },
        "population_size": {
          "minimum": 2,
          "type": "integer"
        },
        "schema_version": {
          "const": 1
        },
        "topology": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "type",
        "population_size",
        "horizon"
      ],
      "type": "object"
    },
    "llm_provider": {
      "additionalProperties": false,
      "properties": {
        "base_url_env": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "credentials_env": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_output_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "max_retries": {
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "type": "object"
        },
        "request_concurrency": {
          "minimum": 1,
          "type": "integer"
        },
        "schema_version": {
          "const": 1
        },
        "temperature": {
          "minimum": 0,
          "type": "number"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "type",
        "model"
      ],
      "type": "object"
    },
    "logging": {
      "additionalProperties": false,
      "properties": {
        "audit": {
          "type": "boolean"
        },
        "comet": {
          "type": "boolean"
        },
        "console": {
          "type": "boolean"
        },
        "level": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "options": {
          "additionalProperties": true,
          "type": "object"
        },
        "schema_version": {
          "const": 1
        }
      },
      "type": "object"
    },
    "prompt": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "options": {
          "additionalProperties": true,
          "type": "object"
        },
        "prompt_family": {
          "minLength": 1,
          "type": "string"
        },
        "prompt_version": {
          "minimum": 1,
          "type": "integer"
        },
        "response_contract": {
          "properties": {
            "type": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "schema_version",
        "prompt_family",
        "prompt_version",
        "blocks",
        "response_contract"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "storage": {
      "additionalProperties": false,
      "properties": {
        "checkpoints": {
          "type": "boolean"
        },
        "format": {
          "minLength": 1,
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "type": "object"
        },
        "output_dir": {
          "minLength": 1,
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        },
        "schema_version": {
          "const": 1
        }
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "llm_provider",
    "prompt",
    "game"
  ],
  "title": "MAS-CC resolved run configuration",
  "type": "object"
}
