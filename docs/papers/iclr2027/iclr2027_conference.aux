\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Exact theory for feedback gain.} (a) State-local action-to-population information for increasing policy gain $\beta $. A sharper policy concentrates information around the switching region and suppresses it where the action saturates. (b) State-averaged local information versus actuation budget for the theory parameter sweeps; the $\beta $ family shows that a more deterministic policy need not transmit more action information overall.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:beta}{{3}{12}{\textbf {Exact theory for feedback gain.} (a) State-local action-to-population information for increasing policy gain $\beta $. A sharper policy concentrates information around the switching region and suppresses it where the action saturates. (b) State-averaged local information versus actuation budget for the theory parameter sweeps; the $\beta $ family shows that a more deterministic policy need not transmit more action information overall}{figure.3}{}}
