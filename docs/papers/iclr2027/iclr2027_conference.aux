\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {State-local response and information.} (a) Empirical signed population drift as a function of target support and actuation budget at $q_c=12$. (b) Empirical state-local action-to-population information above a within-state permutation null. (c) Exact theoretical state-local information landscape for the baseline single-affinity finite-compliance feedback controller. (d) Number of observed rounds supporting each empirical state bin.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:landscapes}{{3}{13}{\textbf {State-local response and information.} (a) Empirical signed population drift as a function of target support and actuation budget at $q_c=12$. (b) Empirical state-local action-to-population information above a within-state permutation null. (c) Exact theoretical state-local information landscape for the baseline single-affinity finite-compliance feedback controller. (d) Number of observed rounds supporting each empirical state bin}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Exact theory for feedback gain.} (a) State-local action-to-population information for increasing policy gain $\beta $. A sharper policy concentrates information around the switching region and suppresses it where the action saturates. (b) State-averaged local information versus actuation budget for the theory parameter sweeps; the $\beta $ family shows that a more deterministic policy need not transmit more action information overall.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:beta}{{4}{13}{\textbf {Exact theory for feedback gain.} (a) State-local action-to-population information for increasing policy gain $\beta $. A sharper policy concentrates information around the switching region and suppresses it where the action saturates. (b) State-averaged local information versus actuation budget for the theory parameter sweeps; the $\beta $ family shows that a more deterministic policy need not transmit more action information overall}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Thermodynamic efficiency exposes the sensing--actuation trade-off}{13}{subsection.6.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {The two control efficiencies and their resource dependence.} (a) Empirical information--response efficiency across the sensing--actuation grid. (b) Exact single-affinity thermodynamic efficiency $\eta _{\rm  th}=hJ_c/(hJ_c+I_{\rm  sens})$ as the actuation budget is varied for the three sensing budgets used experimentally. (c) Empirical sensing information, which rises strongly with $q_c$ without a proportional increase in controlled current.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:efficiencies}{{5}{14}{\textbf {The two control efficiencies and their resource dependence.} (a) Empirical information--response efficiency across the sensing--actuation grid. (b) Exact single-affinity thermodynamic efficiency $\eta _{\rm th}=hJ_c/(hJ_c+I_{\rm sens})$ as the actuation budget is varied for the three sensing budgets used experimentally. (c) Empirical sensing information, which rises strongly with $q_c$ without a proportional increase in controlled current}{figure.5}{}}
