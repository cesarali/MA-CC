\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Efficiency and resource conversion.} (a) Empirical information--response efficiency across the sensing--actuation grid. (b) Exploratory finite-time thermodynamic-efficiency proxy. (c) Exact theory: increasing controller affinity can reduce thermodynamic efficiency because input work grows with control strength. (d) Empirical sensing information, which rises strongly with $q_c$ without a proportional increase in controlled current.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:efficiencies}{{5}{14}{\textbf {Efficiency and resource conversion.} (a) Empirical information--response efficiency across the sensing--actuation grid. (b) Exploratory finite-time thermodynamic-efficiency proxy. (c) Exact theory: increasing controller affinity can reduce thermodynamic efficiency because input work grows with control strength. (d) Empirical sensing information, which rises strongly with $q_c$ without a proportional increase in controlled current}{figure.5}{}}
