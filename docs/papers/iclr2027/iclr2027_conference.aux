\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The complete frozen prompt for the \emph  {Anonymous} family. The \textcolor {focalframing}{\textbf  {orange}} sentence is the only text that differs across the six families; \textcolor {focalprivate}{green} marks the decision maker's private evidence and current commitment, and \textcolor {focalsocial}{blue} marks the focal advocacy that defines the control target (here \textcolor {focalsocial}{West City}).}}{14}{figure.1}\protected@file@percent }
\newlabel{fig:focal-prompt-anonymous}{{1}{14}{The complete frozen prompt for the \emph {Anonymous} family. The \framing {orange} sentence is the only text that differs across the six families; \priv {green} marks the decision maker's private evidence and current commitment, and \social {blue} marks the focal advocacy that defines the control target (here \social {West City})}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B.3}Results}{14}{subsection.B.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The kernel tracks reputation, not identity.}{14}{section*.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The five substituted framing sentences. Everything else in the prompt of Figure~\ref {fig:focal-prompt-anonymous} is identical --- only the anonymous speakers become the named \textcolor {focalsocial}{Agent 2} and \textcolor {focalsocial}{Agent 7} --- so the six renderings of a state are counterfactual twins.}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:focal-prompt-families}{{2}{15}{The five substituted framing sentences. Everything else in the prompt of Figure~\ref {fig:focal-prompt-anonymous} is identical --- only the anonymous speakers become the named \social {Agent 2} and \social {Agent 7} --- so the six renderings of a state are counterfactual twins}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Control-target adoption rate for each model $\times $ prompt family. The column structure is far more stable than the row structure: \texttt  {+Reputation} is the brightest column for every model and \texttt  {-Reputation} the darkest, while \texttt  {Anonymous} and \texttt  {Identity} are nearly indistinguishable.}}{15}{figure.3}\protected@file@percent }
\newlabel{fig:focal-controllability}{{3}{15}{Control-target adoption rate for each model $\times $ prompt family. The column structure is far more stable than the row structure: \texttt {+Reputation} is the brightest column for every model and \texttt {-Reputation} the darkest, while \texttt {Anonymous} and \texttt {Identity} are nearly indistinguishable}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Control-target adoption rate with 95\% task-bootstrap confidence intervals. Kimi K2.6 rates are computed on 40.8\% coverage and are shown for completeness only.}}{16}{table.1}\protected@file@percent }
\newlabel{tab:focal-controllability}{{1}{16}{Control-target adoption rate with 95\% task-bootstrap confidence intervals. Kimi K2.6 rates are computed on 40.8\% coverage and are shown for completeness only}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Truth rate against incorrect-target adoption rate, one point per model $\times $ prompt family. Within each model the points spread horizontally --- the framing moves susceptibility to a misleading controller --- while truth rate varies far less, and the \texttt  {-Reputation} points sit at the left edge with \emph  {lower}, not higher, truth rates.}}{16}{figure.4}\protected@file@percent }
\newlabel{fig:focal-control-vs-truth}{{4}{16}{Truth rate against incorrect-target adoption rate, one point per model $\times $ prompt family. Within each model the points spread horizontally --- the framing moves susceptibility to a misleading controller --- while truth rate varies far less, and the \texttt {-Reputation} points sit at the left edge with \emph {lower}, not higher, truth rates}{figure.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Distrust is a blunt instrument.}{16}{section*.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-task control-target adoption across the six families, one panel per model. The \texttt  {-Reputation} trough appears in almost every task curve, but its depth is strongly task-dependent and a few task/model combinations invert the population-level ordering.}}{17}{figure.5}\protected@file@percent }
\newlabel{fig:focal-all-tasks}{{5}{17}{Per-task control-target adoption across the six families, one panel per model. The \texttt {-Reputation} trough appears in almost every task curve, but its depth is strongly task-dependent and a few task/model combinations invert the population-level ordering}{figure.5}{}}
