# University of Potsdam LLM Proxy (never commit a real key)
POTSDAM_API_KEY=replace-with-your-key
BASE_POTSDAM_LLM_URL=https://replace-with-proxy-base-url
# Optional default for ad-hoc runs; benchmark model IDs come from its config.
POTSDAM_MODEL=gwdg/qwen3-30b-a3b-instruct-2507

# Official OpenAI provider
OPENAI_API_KEY=replace-with-your-openai-key
