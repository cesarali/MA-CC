# University of Potsdam LLM Proxy (never commit a real key)
POTSDAM_API_KEY=replace-with-real-key
BASE_POTSDAM_LLM_URL=replace-with-proxy-base-url
# Optional model overrides for the FullPrompt tutorial.
POTSDAM_MODEL=optional-model-override

# Official OpenAI provider
OPENAI_API_KEY=replace-with-real-key
OPENAI_MODEL=optional-model-override

# Hugging Face model/tokenizer cache (use an absolute high-capacity cluster path)
HF_HOME=/replace/with/high-capacity-storage/huggingface-cache
COMET_API_KEY=replace-with-real-key