.env
.env.*
!.env.example
*.safetensors
huggingface-cache/
.cache/

__pycache__/
*.py[cod]

.ipynb_checkpoints/

.venv/
venv/

.DS_Store
.tags*
*:Zone.Identifier

# Generated benchmark artifacts (inspection bundles live in results/inspection/)
/results/*
!results/studies/
results/studies/*
!results/studies/musr_symbolic_ambiguity_calibration_01/
results/studies/musr_symbolic_ambiguity_calibration_01/*
!results/studies/musr_symbolic_ambiguity_calibration_01/accepted_tasks/
results/studies/musr_symbolic_ambiguity_calibration_01/accepted_tasks/*
!results/studies/musr_symbolic_ambiguity_calibration_01/accepted_tasks/task_001/
results/studies/musr_symbolic_ambiguity_calibration_01/accepted_tasks/task_001/*
!results/studies/musr_symbolic_ambiguity_calibration_01/accepted_tasks/task_001/base_task.json
/docs/reports/results/

# Legacy inspection location - artifacts now go to results/inspection/
inspection/

# Local data folder
data/

# Preflight / inspection artifacts (regenerable, provider-free)
inspection/

# Experiment outputs: large, and regenerable from the configs plus the recorded
# seeds. Ignored by listing CONTENTS rather than the directory itself, because
# git cannot re-include anything under an excluded directory -- and the MuSR
# task datasets live under results/ but are experiment *inputs* that configs
# reference by path and verify by SHA-256, so they must stay committable.
results/*
!results/studies/
results/studies/*
!results/studies/musr_*_calibration_*/

# Paired-initialization artifacts written by `mas-cc study initialize`.
*_initializations/

# LaTeX build artifacts under docs/papers (regenerable; they differ between TeX
# installations, which made every cross-machine pull conflict).  Sources -- .tex,
# .bib, .sty, .bst, .bbl and figures -- stay tracked.
docs/papers/**/*.aux
docs/papers/**/*.blg
docs/papers/**/*.fdb_latexmk
docs/papers/**/*.fls
docs/papers/**/*.log
docs/papers/**/*.out
docs/papers/**/*.synctex.gz
docs/papers/**/*.toc
docs/papers/**/*.lof
docs/papers/**/*.lot
docs/papers/**/*.nav
docs/papers/**/*.snm
docs/papers/**/*.vrb
# compiled papers are regenerable; figure PDFs are source and stay tracked
docs/papers/**/*.pdf
!docs/papers/**/figures/**/*.pdf

# ---------------------------------------------------------------------------
# analysis/ — offline analysis projects.
#
# Rule: code, prose, LaTeX sources, the small finding tables and the final
# report PDF are versioned, so collaborators can read the findings without
# the raw inputs. Everything a script regenerates stays local.
#
#   analysis/<project>/results/   regenerable bulk: parquets, job caches,
#                                 extracted data, run logs. Never versioned.
#   analysis/<project>/report/    main.tex and the built PDF are versioned;
#                                 LaTeX intermediates and figures are not
#                                 (build_report.py regenerates them from the
#                                 tracked CSVs).
# ---------------------------------------------------------------------------
analysis/**/results/
analysis/**/report/figures/
analysis/**/report/*.aux
analysis/**/report/*.out
analysis/**/report/*.toc
analysis/**/report/*.log
analysis/**/report/main.pdf
analysis/**/*.log
