  "facts": [
    {
      "id": "e00_00",
      "text": "Amelia can stay calm under pressure.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Amelia has been the lead on multiple successful missions from the control room.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Vanessa joked about Amelia's serious error in a previous mission, causing a rift in their relationship.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Amelia is straightforward and does not appreciate Vanessa's sarcastic humor.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "David once took a ride in a zero-gravity simulator and became nauseous.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "David was always terrified of heights and still is.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "However, Amelia expressed having reservations about leaving her family behind for extended periods of time.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Amelia has passed base level physical and mental endurance tests necessary for space travel.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Amelia feels undermined and disrespected by David’s behavior.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "David openly criticizes Amelia's decision making in meetings.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Vanessa has a doctorate degree in astrobiology and is immensely passionate about space exploration.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Vanessa showcased tremendous physical resilience during training, even outperforming seasoned astronauts.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "David appreciates Vanessa's knowledge in astrobiology and frequently asks her for advice.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "During team building exercises, David and Vanessa outperformed the rest of the candidates while paired together.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Vanessa has proven her strategic thinking during multiple simulated mission control exercises.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Vanessa has a knack for dealing with technical troubleshooting.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "However, David has struggled with high-stress situations on previous simulation runs.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "David has experience coding for backup systems.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
  ],
