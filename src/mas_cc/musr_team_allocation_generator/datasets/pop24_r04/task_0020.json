  "facts": [
    {
      "id": "e00_00",
      "text": "Alex seems to get overwhelmed by the heavy workload.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Alex forgot to file important documents for a case in the past.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Alex often argues with Michael over case handling strategies.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Michael likes to work independently and dislikes teamwork.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Alex values Madison's skills in analyzing case laws and relishes their intellectual discussions, respecting her decisions and suggestions.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Madison and Alex have a successful history in working together on previous projects.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "It was a straightforward case, and Michael didn't have to exert much effort.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Michael successfully represented a client in a minor case.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Madison consistently demonstrates in-depth knowledge of law and ability to apply it effectively.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Madison has successfully defended major clients in high-profile cases.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "However, Michael spent a significant part of his time that was supposed to be dedicated for his case preparation on conducting the research.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Michael was able to find some useful precedents for a recent case he was working on.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Alex was caught asking basic questions about legal research to junior paralegals.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Alex often gets lost in the vast amount of legal resources and finds it hard to extract relevant information.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Michael finds Madison to be too demanding and prefers to take his own approach to cases.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Madison believes Michael does not value her input and often undermines her in discussions.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Madison's research has been highly praised by her supervisors for its detail and accuracy.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Madison often pulls relevant case law and precedent faster than even her senior associates.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
  ],
