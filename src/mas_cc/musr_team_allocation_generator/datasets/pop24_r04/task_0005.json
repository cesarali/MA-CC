  "facts": [
    {
      "id": "e00_00",
      "text": "Ryan loses concentration when looking at screens for too long.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Ryan has always been a hands-on person.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Maria gets frustrated when she has to follow strict parameters or schedules.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Maria is a creative genius who loves to experiment freely.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Their collaboration resulted in an average outcome.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Ryan and Helen have collaborated on a project before.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "However, Helen sometimes misses the bigger picture and overall concept.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Helen tends to focus on smaller details and can be quite meticulous.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Maria has won several cooking competitions with her unique and flavourful dishes.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Maria has spent years working in the kitchen honing her culinary skills.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Helen loved cooking from a young age, often experimenting with various ingredients and techniques.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Helen attended culinary school and interned at a high-end restaurant.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Ryan often finds it hard to work with Maria's unpredictable work methods.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Maria cannot stand people who cannot follow her creative process.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Maria disregards Helen's methodical recipes and cooking techniques.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Helen has publicly criticised Maria's experimental approach in cooking.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Ryan confessed being uninterested in watching cooking shows or reading recipe books.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Ryan tends to forget common ingredients in recipes.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
