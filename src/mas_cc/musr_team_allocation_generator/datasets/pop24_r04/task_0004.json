      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Barbara admits she does not enjoy this aspect of the job and puts in minimal effort.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Barbara has often overlooked important details in the data.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Barbara always insists on doing things her own way, leading to conflicts with Tom, who values precision and process.",
