  "facts": [
    {
      "id": "e00_00",
      "text": "Antonio tried to sketch some car models but failed to create an aesthetically pleasing design.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Antonio has a degree in mechanical engineering, not in design.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Antonio has shown a pattern of making errors on data interpretation tasks.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Antonio made a mistake in his last market analysis by misunderstanding demographic data.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Lisa's previous sketch has been the most voted for in a recent internal contest.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Lisa has a degree in car design from a reputable university.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "Antonio respects Lisa's creative inputs while improving the car's functionality.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Lisa learnt from Antonio how to implement her designs technically.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "James studied mechanical engineering, not business or marketing.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "James misinterpreted data on consumer preferences in a recent report.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Lisa has admitted to finding the task of market research dull and tiresome.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Lisa was unable to derive key insights from a customer survey.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Lisa found James's engineering recommendations impractical for her designs.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "James and Lisa had a disagreement over the aesthetic aspects of a car model last week.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "James holds a graduate degree in automotive design.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "James won an award for his design of a concept car last year.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "James criticized Antonio's understanding of car aesthetics openly in a staff meeting.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Antonio dismissed James' suggestions during a design meeting.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
