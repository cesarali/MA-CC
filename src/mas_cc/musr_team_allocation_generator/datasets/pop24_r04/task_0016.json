      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Carlos was manager at his father's construction firm for two years.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Carlos chose to work back-house in the restaurant, avoiding any interaction with the customers.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Carlos huffed and rolled his eyes when asked to assist guests during his restaurant job.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Anna often finds excuses to avoid social events.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Anna declined an offer to work as a guest relations officer at her previous job.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
