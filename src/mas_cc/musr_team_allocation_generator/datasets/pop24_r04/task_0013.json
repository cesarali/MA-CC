  "facts": [
    {
      "id": "e00_00",
      "text": "The pastries Andrew used to make required complex techniques, but he only did simple tasks like adding toppings.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Andrew used to work at a bakery making pastries.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Andrew finds Emma's constant nagging stressful and distracting.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Emma often complains about Andrew's sloppy packaging methods.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Mark feels insulted and demotivated by Emma's sharp critical remarks.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Emma gets irritated when Mark frequently forgets to attach the labels on the packaging.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "The neighborhood bake sale Mark participated in was a disaster due to his terrible cakes.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Mark once mistook salt for sugar in a cake recipe.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "She manages to pack and inventory the jars efficiently despite it being a hobby.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Emma often lends a hand in the family business, which involves packing homemade jams.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Mark used to arrange and pack the family groceries every week.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Mark always ensures his personal belongings are perfectly neat and organized.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "She learned many recipes from her grandmother who was a professional baker.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Emma has been baking bread for her family meals for years.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Andrew and Mark successfully set up a charity food stall together last year.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Andrew and Mark are often seen hanging out during breaks.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Andrew was frequently praised for his neat, quick and efficient packaging skills.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Andrew used to work in the packaging department of a toy company.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
