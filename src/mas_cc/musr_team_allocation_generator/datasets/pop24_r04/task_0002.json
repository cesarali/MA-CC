  "facts": [
    {
      "id": "e00_00",
      "text": "Olivia has a previous experience in a software support role where she had to spot issues with software.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Olivia has moderately high attention to detail which she reveals by always noticing small changes around the office.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Jake and Olivia have successfully completed a handful of minor projects in record time.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Jake and Olivia often pair up to solve problems during brainstorming sessions.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Jake has high patience levels and enjoys solving puzzles, as seen from his love for Sudoku puzzles.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Jake has a prior experience in debugging complex codes as a freelancer.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "Alice has admitted to disliking tasks that require meticulous attention to detail - she prefers to work on big picture projects.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Alice gets quickly frustrated while problem-solving, often opting to give up if she does not find a solution immediately.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Olivia has on several occasions admitted her dislike for the precision needed in coding.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Olivia struggles with understanding complex algorithms and logic, as reported by her peers.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Jake and Alice often spend their breaks together, suggesting a positive social relationship.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Alice often brings up Jake's ideas during team sessions, indicating a mutual respect.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Jake finds it stressful to come up with solutions and struggles to turn his ideas into functioning code, leading to dismal project outcomes.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Jake constantly mixes up the syntax in the programming languages, often requesting to refer to his notes.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "When asked to work together, the final result tends to be subpar as compared to when they optimize their individual strengths.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Alice and Olivia rarely engage in conversation with each other during group discussions.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Alice, though not exceptional, is able to produce code meeting the required functionality within reasonable timeframes.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Alice has experience in various programming languages due to her computer science degree.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
  ],
