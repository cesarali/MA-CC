  "facts": [
    {
      "id": "e00_00",
      "text": "Martin prefers a more collaborative approach and doesn't respond well to criticism.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Emily often criticizes Martin's methods in front of other staff members.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "In the past, Martin has successfully diagnosed challenging cases in patients with rare diseases.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Martin has a medical degree and several years of experience in patient care.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Chloe ends up scheduling multiple patients at the same time due to Emily's forgetfulness.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Emily keeps forgetting to inform Chloe about her schedule changes.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "However, Chloe struggles with meeting all the deadlines and often works overtime to complete the work.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Chloe rarely makes an error in maintaining records and usually schedules appointments correctly.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Martin frequently helps Chloe when she struggles with her workload.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Martin has an in-depth understanding of the clinic's scheduling system.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Chloe not only has a nursing degree but has also taken several diagnostic courses.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Chloe often fills in for Martin when he's not available and has correctly diagnosed patients during these times.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Emily loses records and has trouble locating the ones she supposedly filed.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Emily often mixes up the appointment timings, causing confusion among the patients.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Emily has majored in medicine and has been a healthcare provider for nearly a decade.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Emily has been successful in identifying patient health issues in the past.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Chloe consistently thanks Martin for his help and praises his work in front of their peers.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Whenever Chloe has to work late, Martin offers to watch her children.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
  ],
