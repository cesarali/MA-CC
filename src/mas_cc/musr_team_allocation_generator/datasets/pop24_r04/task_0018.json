  "facts": [
    {
      "id": "e00_00",
      "text": "Taylor's fear of fire has grown significantly after witnessing a major fire incident in his neighborhood.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Taylor used to work in an office environment, having never been exposed to intense fires before.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Taylor accused Alex of not properly coordinating their actions in that same operation.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Alex blamed Taylor for a failed rescue operation they were on together.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Alex has failed his victim first-aid certification test multiple times.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Alex easily gets nervous in stressful situations.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "Sam excelled in his first-aid certification test, getting a distinction.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Sam has worked as a lifeguard for five years, saving several swimmers from drowning.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Sam was visibly scared during practice sessions with controlled fires.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Sam was only certified to work as a lifeguard, a position that required minimal fire handling.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Alex has stated he cannot trust Sam because he doesn't follow orders.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Sam often ignores Alex's instructions.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Taylor didn't try to calm down or help the injured when he witnessed the fire in his neighbourhood.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Taylor freezes whenever he has to deal with victims screaming in pain and horror.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Taylor deeply respects Sam's abilities and always listens to Sam's suggestions.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Sam often covers for Taylor, doing Taylor's share of the stress-inducing work.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Alex's hands shake when he tries to hold the fire hose during trainings.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Alex has always been afraid of heat and used to avoid camping trips to avoid being around fire.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
  ],
