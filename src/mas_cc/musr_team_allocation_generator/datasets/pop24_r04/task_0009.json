  "facts": [
    {
      "id": "e00_00",
      "text": "Not many of her colleagues knew about her run-in with server management.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Debbie had run a small personal website for a few years.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Megan is quiet and sensitive, often feeling overwhelmed by confrontational people.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Debbie has a strong, outspoken personality and is easily frustrated.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Tom's hobby coding projects has dealt with solving everyday problems around the house.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Tom has been coding as a hobby for the past 5 years.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "Tom is known to have excellent problem solving and critical thinking skills by his peers.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Tom has worked as a server administrator in the past for a reputable tech company.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Tom gets frustrated because of the lack of recognition from Debbie.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Debbie often underestimates Tom's knowledge about server infrastructure.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Debbie studied software engineering at a top university and graduated with honors.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Debbie has led several successful software development projects in her career.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Megan did a specialized course to strengthen her knowledge about different server architectures.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Megan has worked at a tech support center before, dealing with server related issues.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Megan did not receive any specialized training in software development.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Megan mostly worked on hardware projects during her tenure in the tech support center.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Tom feels Megan micromanages him and this has caused several heated debates in the team.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Megan does not respect Tom's problem-solving approach and often challenges his decisions.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
