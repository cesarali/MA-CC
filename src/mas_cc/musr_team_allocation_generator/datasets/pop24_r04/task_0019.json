  "facts": [
    {
      "id": "e00_00",
      "text": "Olivia consistently shows little interest in understanding old cases and precedents.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Olivia never pursued higher studies in law.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Both Gabriel and Olivia are competitive and want to prove they're right, leading to clashes.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Gabriel and Olivia had a heated argument over a case, causing a fall out.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Olivia did not pass her legal writing course during her law degree.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Olivia struggles with articulating legal arguments succinctly.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "Emily constantly keeps herself updated and excited about landmark cases, often referencing them.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Emily has a PhD in Law, with a specialty in legal research.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Emily holds a grudge against Gabriel due to this public humiliation.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Gabriel criticized Emily's ideas in the team meeting.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Emily finds it difficult to respect Olivia due to her lack of interest in case laws.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Olivia often dismisses Emily's meticulous approach to law research.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Emily received negative feedback from a professor in law school on her ability to draft concise briefs.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Emily is adept at detailed research but has trouble summarizing her findings.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Gabriel hasn't kept himself updated with recent changes in law.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Gabriel often misses out on important case details while studying them.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Gabriel's written arguments often lack organization and clarity.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Gabriel hasn't taken any specialized training in legal writing.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
  ],
