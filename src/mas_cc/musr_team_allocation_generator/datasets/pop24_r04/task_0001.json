  "facts": [
    {
      "id": "e00_00",
      "text": "Charlie often mixes up orders and has difficulty handling the rush during lunch hours.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Charlie was previously a janitor and has no experience in the food industry.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Bob sometimes forgets to restock salt and pepper shakers but doesn't mess up the orders.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Bob has been working in the food industry for a couple of years.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Charlie has appreciated Bob's knowledge about food ordering and handling.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Bob and Charlie have successfully co-managed the cafeteria during rush hours.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": ">Bob gets irritated by Alice because, she is frequently lost in thoughts, slowing down their work.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": ">Alice dislikes Bob because he reminds her of a bully from her childhood.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Charlie feels that Alice micromanages, which hinders his workflow.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Alice is often irritated by Charlie's lack of discipline in his work.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Alice used to be a house cleaner before she started working at the office.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Alice tirelessly ensures that every corner of the office is dust-free.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Charlie suffers from dust allergies, aggravating his condition during cleanup.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Charlie dislikes handling dirty items, leaving tasks incomplete.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Bob is scared of bugs and avoids cleaning areas where they might be present.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Bob can't handle strong cleaning agents due to his sensitive skin.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Alice has difficulty multitasking during rush on lunch hours.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Alice never paid attention in the culinary arts class during high school.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
