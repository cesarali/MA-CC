    },
    {
      "id": "e01_00",
      "text": "Ethan prefers solitude and does not express himself well in social settings or engage actively in conversation.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Ethan had been repeatedly avoiding social events.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Both Jessica and Anna are stubborn and refuse to compromise on their ideas.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Jessica and Anna have clashed over creative differences in the past.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "In the past, Jessica got frazzled when asked to review contracts.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Jessica struggles with understanding complex legal terms.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Anna doesn't have a good grip on managing social media.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Anna often got flustered during public speaking.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Ethan has an introverted personality and prefers to work alone.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Jessica has an assertive, outgoing personality, often taking the lead on tasks.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Ethan has a reputation of clarifying legal documents accurately among his peers.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Ethan is always up-to-date with recent changes in laws and regulations related to the entertainment industry.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Jessica is able to speak persuasively and confidently in front of large groups.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Jessica has successful experience running local community media campaigns.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Anna is more spontaneous and tends to make quick decisions based on her intuition.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Ethan is very meticulous and prefers to double-check all the details before making a decision.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
