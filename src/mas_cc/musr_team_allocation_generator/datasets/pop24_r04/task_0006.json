  "facts": [
    {
      "id": "e00_00",
      "text": "Michael is a team player who thrives on collaboration.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Emily is a perfectionist and prefers to work alone.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Rachel loves to dive into the complexities of characters in her favorite novels.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Rachel has a degree in psychology, providing her a deep understanding of motivations and behavior.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Rachel loves to determine how momentary events in a story tie into the bigger picture.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Rachel has won awards in screenwriting which requires plot structures.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "Michael has expressed frustration in the past about understanding character emotions.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Michael is methodical and places high importance on structure and timeline.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Michael shows a keen interest in studying the plots of popular novels.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Michael has worked on creating timelines for previous projects.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Emily places a higher emphasis on perfection in character development rather than developing the story's plot.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Emily has a tendency to disregard the significance of consecutive events leading to a climax.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Emily gets upset when timelines she hasn't approved are used.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Rachel likes to create her own timelines for character development.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Emily would write character driven one-act plays in college and they were always well received.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Emily has a nuanced understanding of human emotions.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Michael is focused strictly on the structure and can dismiss creative inputs.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Rachel often has innovative, creative suggestions that deviate from the established structure.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
