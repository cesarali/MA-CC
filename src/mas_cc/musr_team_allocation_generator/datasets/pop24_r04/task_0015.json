  "facts": [
    {
      "id": "e00_00",
      "text": "The disagreement created lingering tension between them causing their performances to be out of sync.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Elizabeth and George had a disagreement during a previous performance.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Carla often found the requirements of reading bass clef music confusing.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Carla couldn't master the finger positioning required for the cello.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "She frequently has trouble with intonation and keeping pitch when switching notes.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Elizabeth has a hard time maintaining the proper bow grip needed for playing various notes.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "The two still have not sorted out their differences and often avoid each other during practice.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Elizabeth and Carla had a falling out over a solo performance opportunity a year ago.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Carla also has trouble maintaining the fast paced rhythm required for many violin pieces.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Carla struggles to adapt to the high dexterity required for changing strings quickly on violin.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Elizabeth expressed frustration in getting the right pressure and weight distribution during bowing.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Elizabeth has a fear of larger string instruments due to a childhood incident involving a bass violin.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "George prefers the rich tone of the cello, but still struggles with fast passages.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "George managed to play cello in a community orchestra for a couple of years.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Carla and George often practice together in their free time.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "George often helps Carla with the difficult parts of her music.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "George was unable to achieve a smooth and stable vibrato on the violin.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "George finds the higher octaves of the violin uncomfortable and jarring to his ears.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
  ],
