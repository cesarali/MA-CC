  "facts": [
    {
      "id": "e00_00",
      "text": "They often bicker when they are assigned to work together.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Robert and Laura have opposing views about how dishes should be delivered.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "There have been multiple customer complaints about late delivery when Robert was the one delivering.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Robert has trouble reading maps and frequently gets lost.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Laura also lacks knowledge on the city's street layout, often relying on GPS for routes.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Laura has a driving record with several minor accidents and traffic violations.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "Melinda has a degree in business administration focusing on hospitality and restaurant management.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Melinda has previously managed a highly successful food truck business for 5 years.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Robert felt undermined by Melinda and held a grudge against her since then.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "Melinda once had to step in and correct a significant mistake in a food order that Robert made.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Melinda believes Laura does not take her responsibilities seriously enough and lacks focus.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Laura finds Melinda's high-energy and fast-paced style of management too stressful to handle.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Several past projects under Robert's direction have gone over budget and failed to meet timeline goals.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Robert lacks leadership and is indecisive under pressure.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "Laura has trouble accepting and addressing feedback from her team members.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Laura struggles with multi-tasking and easily gets overwhelmed during peak hours.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Melinda gets quite stressed when she has to rush, which is often the case with delivery roles.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Melinda is a perfectionist who insists on quality presentation and spends a lot of time perfecting each delivery.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
  ],
