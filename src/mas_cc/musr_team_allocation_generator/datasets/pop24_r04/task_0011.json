  "facts": [
    {
      "id": "e00_00",
      "text": "Hannah received negative feedback from customers about her reluctance to help with their queries.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e00_01",
      "text": "Hannah has an introverted personality and often struggles to initiate conversations.",
      "root_claim_id": "c00",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_00",
      "text": "Hannah feels undermined by Mark's assertiveness and hence avoids cooperation.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e01_01",
      "text": "Mark has a strong and dominant personality, often overruling Hannah's input in team decisions.",
      "root_claim_id": "c01",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_00",
      "text": "Tina has started to skip meetings to avoid Mark’s interruptions, reflecting their poor teamwork.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e02_01",
      "text": "Mark consistently interrupts Tina during company meetings, showing a lack of respect for her views.",
      "root_claim_id": "c02",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_00",
      "text": "Tina still sometimes needs to ask others for help or suggestions when arranging complex displays.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e03_01",
      "text": "Tina has worked part-time at a clothing store during college, where her duties included arranging clothes on racks.",
      "root_claim_id": "c03",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_00",
      "text": "Mark has a friendly, outgoing personality and is naturally fond of socializing with people.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e04_01",
      "text": "During team trainings, Mark spent extra time role-playing and practicing possible customer interactions.",
      "root_claim_id": "c04",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_00",
      "text": "Mark never bothers to read the display arrangement instructions thoroughly before starting.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e05_01",
      "text": "Mark often places products on the wrong shelves, causing confusion for customers.",
      "root_claim_id": "c05",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_00",
      "text": "Tina often forgot to share important updates with Hannah, making them inefficient as a team.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e06_01",
      "text": "Hannah has a quiet voice, which Tina constantly fails to hear during team discussions.",
      "root_claim_id": "c06",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_00",
      "text": "There were some instances when Tina lost her temper with irate customers.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e07_01",
      "text": "Tina gets easily overwhelmed with a high volume of customer queries and often gets flustered.",
      "root_claim_id": "c07",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_00",
      "text": "Hannah has explained that she has difficulty visualizing how display elements work together to create an appealing presentation.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    },
    {
      "id": "e08_01",
      "text": "Hannah often neglects to implement the display protocols set by the store management.",
      "root_claim_id": "c08",
      "kind": "musr_explicit_leaf"
    }
  ],
